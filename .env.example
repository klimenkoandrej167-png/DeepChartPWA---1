# Deriv — get your own app_id at developers.deriv.com/dashboard
# app_id may be alphanumeric (not just numeric). Leave empty to use demo 1089.
VITE_DERIV_APP_ID=

# Optional: Deriv Personal Access Token (pat_...) — only needed for account data,
# NOT for public candle/tick streams. Leave empty for chart-only terminal.
VITE_DERIV_TOKEN=

# Optional: TwelveData API key for forex fallback
VITE_TWELVEDATA_API_KEY=

# Optional: Finnhub API key for forex fallback
VITE_FINNHUB_API_KEY=

# Binance key not required — public market-data API
